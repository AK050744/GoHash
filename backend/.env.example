# Server Environment
PORT=5000
NODE_ENV=development

# Database (MongoDB connection URI)
MONGODB_URI=mongodb://localhost:27017/gohash

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# File Limits
MAX_FILE_SIZE_MB=10

# Database Seed Credentials (for npm run seed)
SEED_ADMIN_NAME="GoHash Administrator"
SEED_ADMIN_EMAIL=admin@gohash.io
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_NOTARY_NAME="GoHash Official Notary"
SEED_NOTARY_EMAIL=notary@gohash.io
SEED_NOTARY_PASSWORD=NotaryPassword123!

# Blockchain (Hardhat local node / testnet) - Preserved for Days 1-3 & Days 8-10
CHAIN_RPC_URL=http://127.0.0.1:8545
NOTARY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
