# Server Environment
PORT=5000
NODE_ENV=development

# Database (MongoDB connection URI)
MONGODB_URI=mongodb://localhost:27017/gohash
MONGODB_URI_TEST=mongodb://localhost:27017/gohash_test

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# File Limits
MAX_FILE_SIZE_MB=10

# Database Seed Credentials (for npm run seed)
SEED_ADMIN_NAME="GoHash Administrator"
SEED_ADMIN_EMAIL=admin@gohash.io
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_NOTARY_NAME="GoHash Official Notary"
SEED_NOTARY_EMAIL=notary@gohash.io
SEED_NOTARY_PASSWORD=NotaryPassword123!

# Blockchain — read-only RPC (no private key or mnemonic ever stored here)
# Start the Hardhat local node, then run the deploy script to generate localhost.json
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
DEPLOYMENT_FILE=../blockchain/deployments/localhost.json
